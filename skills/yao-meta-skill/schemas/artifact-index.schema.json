{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yao.example/schemas/artifact-index.schema.json",
  "title": "Yao Evidence Artifact Index",
  "type": "object",
  "required": ["schema_version", "run_id", "skill_name", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "skill_name": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {"type": "string", "pattern": "^reports/[^/].*"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
