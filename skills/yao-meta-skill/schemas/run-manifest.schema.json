{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yao.example/schemas/run-manifest.schema.json",
  "title": "Yao Evidence Run Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "skill_name",
    "created_at",
    "source",
    "artifact_count",
    "artifact_index_sha256",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "skill_name": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"type": ["string", "null"]},
        "dirty": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "artifact_count": {"type": "integer", "minimum": 1},
    "artifact_index_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"const": "built"}
  },
  "additionalProperties": false
}
